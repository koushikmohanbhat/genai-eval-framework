# Copy to .env (never commit .env). genai-evals loads ./.env automatically; real environment variables win.
# Only set what your profiles and sources use.

# ---- which providers file and profiles the suite uses (defaults are the offline mocks)
# GENAI_EVALS_PROVIDERS=providers.live.yaml
# EVAL_TARGET_PROFILE=bedrock
# EVAL_JUDGE_A=judge-openai
# EVAL_JUDGE_B=judge-gemini

# ---- OpenAI (direct)
# OPENAI_API_KEY=
# OPENAI_MODEL=
# JUDGE_OPENAI_MODEL=

# ---- Anthropic (direct)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# ---- AWS (credentials come from the standard chain: SSO / profile / role; not from this file)
# AWS_REGION=
# AWS_PROFILE=
# BEDROCK_MODEL_ID=
# BEDROCK_GUARDRAIL_ID=
# AGENT_SERVICE_NAME=
# AGENTCORE_SPANS_LOG_GROUP=aws/spans
# BEDROCK_INVOCATION_LOG_GROUP=
# AGENTCORE_MEMORY_ID=

# ---- Google Cloud (credentials come from ADC: `gcloud auth application-default login` or a service account)
# GCP_PROJECT=
# GCP_LOCATION=
# VERTEX_MODEL=
# JUDGE_VERTEX_MODEL=
# VERTEX_REQUEST_RESPONSE_TABLE=bq://<project>.<dataset>.<table>
# AGENT_ENGINE_RESOURCE=projects/<project>/locations/<location>/reasoningEngines/<id>

# ---- DPDP: stable tokenisation key so the same value gets the same token across runs (store it in a secret manager)
# GENAI_EVALS_TOKEN_KEY=

# ---- online evals
# ONLINE_SAMPLING=0.05
